# Visual Studio build artifacts and caches
x64/
x86/
Debug/
Release/
.vs/

# Per-user VS settings
*.user
*.suo

# Compiled objects and debug files
*.obj
*.pdb
*.ilk
*.exe

# Index snapshot cache (derived from data/, safe to delete and rebuild)
index.bin
index.bin.tmp

# Dense vector snapshot cache (derived from data/ + the embedding
# model, safe to delete and re-embed)
vector.bin
vector.bin.tmp

# Python
__pycache__/

# Qt VS Tools per-project build rules (regenerated by the extension)
MY_CTF_RAG/MY_CTF_RAG_GUI/QtMsBuild/

# Test-run compile logs (written by tests\run_tests.bat)
MY_CTF_RAG/tests/_b_*.txt

# Local AI-assistant session state
.claude/

# Data-harvest staging (intermediate; final data lands in wp_pool/raw)
staging_new/

